[Unit]
Description=OVRLand local dashboard service
After=network.target pipewire.service wireplumber.service
Wants=pipewire.service wireplumber.service

[Service]
Type=simple
WorkingDirectory=@OVRLAND_ROOT@
Environment=OVRLAND_MODE=live
EnvironmentFile=-%h/.config/ovrland/ovrland.env
ExecStart=@OVRLAND_ROOT@/.venv/bin/python -m uvicorn app:app --host 127.0.0.1 --port 8000 --no-proxy-headers
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
